<Window x:Class="LabMaster.PatientSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Patient Search" Height="600" Width="950" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Patient Search" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Text="Find existing patients by MR number, name or phone" Foreground="{StaticResource MutedTextBrush}" Margin="0,38,0,15"/>
<DockPanel Grid.Row="1" Margin="0,10,0,18"><TextBox x:Name="SearchBox" Height="38" Width="500" FontSize="15" VerticalContentAlignment="Center"/><Button Content="Search" Width="110" Height="38" Margin="10,0,0,0" Click="Search_Click"/></DockPanel>
<DataGrid x:Name="PatientsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="{StaticResource CardBrush}" Foreground="White" RowBackground="{StaticResource CardBrush}" AlternatingRowBackground="#243044" SelectionChanged="PatientsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="MR Number" Binding="{Binding MRNumber}" Width="150"/><DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="*"/><DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="100"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="170"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Close" Width="100" Height="38" Click="Close_Click"/></StackPanel>
</Grid></Window>