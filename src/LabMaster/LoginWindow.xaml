<Window x:Class="LabMaster.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lab Master Login" Height="430" Width="430" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
<Grid Margin="38"><StackPanel VerticalAlignment="Center"><TextBlock Text="LAB MASTER" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Secure Laboratory Information System" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,28"/><TextBlock Text="Username" Foreground="White"/><TextBox x:Name="UserBox" Height="38" Padding="10" Margin="0,6,0,14"/><TextBlock Text="Password" Foreground="White"/><PasswordBox x:Name="PasswordBox" Height="38" Margin="0,6,0,18"/><Button Content="LOGIN" Height="42" Click="Login_Click"/><TextBlock x:Name="StatusText" Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel></Grid></Window>