<Window x:Class="LabMaster.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Profile Master" Height="680" Width="1050" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Profile Master" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Grid.Row="1" Text="Create reusable test panels and manage their included tests." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="＋  Add Profile" Height="38" Click="Add_Click"/><Button Content="Enable / Disable" Height="36" Margin="0,8,0,12" Click="Toggle_Click"/></StackPanel><DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White" SelectionChanged="Grid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding ProfileCode}" Width="105"/><DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="SelectedProfileText" Text="Select a profile" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,14"/><StackPanel Orientation="Horizontal"><Button Content="＋ Add Test" Width="120" Height="36" Click="AddTest_Click"/><Button Content="Remove Test" Width="120" Height="36" Margin="8,0,0,0" Click="RemoveTest_Click"/></StackPanel></StackPanel><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding DisplayOrder}" Width="50"/><DataGridTextColumn Header="Code" Binding="{Binding TestCode}" Width="120"/><DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border></Grid></Grid></Window>