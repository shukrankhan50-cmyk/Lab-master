<Window x:Class="LabMaster.AddAnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Analyzer" Height="620" Width="520" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Add Analyzer / Instrument" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBox x:Name="CodeBox" Height="36" Margin="0,0,0,8" ToolTip="Analyzer code"/><TextBox x:Name="NameBox" Height="36" Margin="0,0,0,8" ToolTip="Analyzer name"/><ComboBox x:Name="DepartmentBox" Height="36" Margin="0,0,0,8" DisplayMemberPath="DepartmentName"/><TextBox x:Name="ManufacturerBox" Height="36" Margin="0,0,0,8" ToolTip="Manufacturer"/><TextBox x:Name="ModelBox" Height="36" Margin="0,0,0,8" ToolTip="Model"/><TextBox x:Name="SerialBox" Height="36" Margin="0,0,0,8" ToolTip="Serial number"/><TextBox x:Name="ConnectionBox" Height="36" Margin="0,0,0,8" ToolTip="Connection type (Manual/LIS/Serial/USB)"/><StackPanel Orientation="Horizontal" Margin="0,5,0,8"><DatePicker x:Name="LastCalibrationBox" Width="200"/><DatePicker x:Name="NextCalibrationBox" Width="200" Margin="8,0,0,0"/></StackPanel><TextBox x:Name="NotesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Notes"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" Width="100" Height="38" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Save" Width="100" Height="38" Click="Save_Click"/></StackPanel></Grid></Window>