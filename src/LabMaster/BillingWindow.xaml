<Window x:Class="LabMaster.BillingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Billing &amp; Receipts" Height="700" Width="1100" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Billing &amp; Receipts" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Receive payment against laboratory orders" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<DataGrid x:Name="BillsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="BillsGrid_SelectionChanged" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="110"/><DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="100"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/><DataGridTextColumn Header="Paid" Binding="{Binding Paid}" Width="100"/><DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="100"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><TextBlock x:Name="BalanceLabel" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/><TextBox x:Name="AmountBox" Width="120" Height="36" Padding="8" Margin="0,0,8,0"/><ComboBox x:Name="MethodBox" Width="120" Height="36" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem>Cash</ComboBoxItem><ComboBoxItem>Card</ComboBoxItem><ComboBoxItem>Bank</ComboBoxItem></ComboBox><Button Content="Receive Payment" Width="150" Height="36" Click="Receive_Click"/><Button Content="Receipt History" Width="130" Height="36" Margin="10,0,0,0" Click="History_Click"/></StackPanel></Grid></Window>