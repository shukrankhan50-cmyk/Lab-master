<Window x:Class="LabMaster.BillingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Billing &amp; Receipts"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Billing &amp; Receipts" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Receive and manage payments against laboratory orders"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="BillsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="BillsGrid_SelectionChanged"
                      Background="{StaticResource CardBrush}"
                      Foreground="White"
                      RowBackground="{StaticResource CardBrush}"
                      AlternatingRowBackground="#243044">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="110"/>
                    <DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="105"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="16" Margin="0,15,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Selected Order" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="BalanceLabel" Text="" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox x:Name="AmountBox" Grid.Column="1" Height="38" Padding="8"
                         VerticalAlignment="Bottom" Margin="8,0"/>

                <ComboBox x:Name="MethodBox" Grid.Column="2" Height="38"
                          VerticalAlignment="Bottom" SelectedIndex="0" Margin="8,0">
                    <ComboBoxItem Content="Cash"/>
                    <ComboBoxItem Content="Card"/>
                    <ComboBoxItem Content="Bank"/>
                </ComboBox>

                <Button Grid.Column="3" Content="Receive Payment" Height="38"
                        VerticalAlignment="Bottom" Margin="8,0"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Receive_Click"/>

                <Button Grid.Column="4" Content="Clear" Height="38"
                        VerticalAlignment="Bottom" Margin="8,0"
                        Click="Clear_Click"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Recent Receipts"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <DataGrid x:Name="ReceiptsGrid" Grid.Row="1" Grid.ColumnSpan="3"
                          Margin="0,8,8,0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single"
                          Background="{StaticResource CardBrush}"
                          Foreground="White"
                          RowBackground="{StaticResource CardBrush}"
                          AlternatingRowBackground="#243044">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="180"/>
                        <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="110"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="90"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat=dd-MMM-yyyy HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Vertical" Margin="8,8,0,0">
                    <Button Content="Refresh Receipts" Height="34" Margin="0,0,0,8" Click="RefreshReceipts_Click"/>
                    <Button Content="Print Selected Receipt" Height="34" Click="PrintReceipt_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>