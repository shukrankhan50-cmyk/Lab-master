<Window x:Class="LabMaster.AuditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Audit Log" Height="650" Width="1050" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Audit Log" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Recent system activity and security events" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Date/Time" Binding="{Binding CreatedAt}" Width="170"/><DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/><DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="130"/><DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="70"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Refresh" Width="110" Height="38" Click="Refresh_Click"/></StackPanel></Grid></Window>