<Window x:Class="LabMaster.AcceptTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Accept Test" Height="700" Width="1100" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Accept Test / Test Registration" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select patient and multiple laboratory tests" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal"><TextBox x:Name="MrBox" Width="180" Height="38" VerticalContentAlignment="Center"/><Button Content="Find Patient" Width="110" Height="38" Margin="8,0,20,0" Click="FindPatient_Click"/><TextBlock x:Name="PatientLabel" Text="No patient selected" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/></StackPanel>
<Grid Grid.Row="2" Margin="0,20,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="15" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox x:Name="TestSearchBox" Width="300" Height="36"/><Button Content="Search" Width="90" Height="36" Margin="8,0,0,0" Click="Search_Click"/></StackPanel><DataGrid x:Name="TestsGrid" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"><DataGrid.Columns><DataGridCheckBoxColumn Header="Select" Binding="{Binding Selected}" Width="55"/><DataGridTextColumn Header="Code" Binding="{Binding TestCode}" Width="90"/><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/><DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="150"/><DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="15" Margin="8,0,0,0"><StackPanel><TextBlock Text="Selected Tests" Foreground="White" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="SelectedList" Margin="0,12,0,0" Height="280"/><TextBlock x:Name="TotalLabel" Text="Total: Rs. 0" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,18,0,0"/></StackPanel></Border></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Create Order" Width="150" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="CreateOrder_Click"/></StackPanel>
</Grid></Window>