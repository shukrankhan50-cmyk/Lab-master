<Window x:Class="LabMaster.AcceptTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Accept Test" Height="720" Width="1150" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Accept Test / Create Order" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select a patient, choose one or more laboratory tests, then create the order." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,15"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15"><TextBox x:Name="MrBox" Width="180" Height="36" Padding="8"/><Button Content="Find Patient" Width="110" Height="36" Margin="8,0,12,0" Click="FindPatient_Click"/><TextBlock x:Name="PatientLabel" Foreground="White" VerticalAlignment="Center"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<StackPanel><TextBox x:Name="TestSearchBox" Height="36" Padding="8" Margin="0,0,0,8" TextChanged="Search_TextChanged"/><DataGrid x:Name="TestsGrid" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding TestCode}" Width="100"/><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/><DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="170"/><DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel>
<Border Grid.Column="1" Background="{StaticResource CardBrush}" Margin="14,0,0,0" Padding="18"><StackPanel><TextBlock Text="Selected Tests" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use Ctrl/Shift to select multiple rows." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12"/><TextBlock x:Name="SelectedLabel" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="TotalLabel" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="0,15,0,0"/></StackPanel></Border></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Create Order" Width="150" Height="40" Click="CreateOrder_Click"/></StackPanel></Grid></Window>