<Window x:Class="LabMaster.AnalyzerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Analyzer / Instruments" Height="680" Width="1100" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Analyzer / Instruments" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="AlertText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,15"/></StackPanel><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Analyzer" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/><DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="140"/><DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/><DataGridTextColumn Header="Next Calibration" Binding="{Binding NextCalibration,StringFormat=dd-MMM-yyyy}" Width="130"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="65"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Enable / Disable" Width="130" Height="38" Margin="0,0,8,0" Click="Toggle_Click"/><Button Content="Add Analyzer" Width="130" Height="38" Click="Add_Click"/></StackPanel></Grid></Window>