<Window x:Class="LabMaster.DepartmentSlipWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Department Slips" Height="720" Width="1150" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Department Slips" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,15"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Order_SelectionChanged" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="100"/><DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="90"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Column="1" Background="White" Margin="15,0,0,0" Padding="28"><StackPanel x:Name="SlipPanel" Width="650"><TextBlock Text="DEPARTMENT SAMPLE / TEST SLIP" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/><TextBlock x:Name="PatientText" Margin="0,18,0,12" Foreground="#111827" FontSize="13"/><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="400" Background="White" Foreground="#111827"><DataGrid.Columns><DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="170"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid><TextBlock Text="Process and collect samples according to department SOP." Foreground="#6B7280" FontSize="11" Margin="0,15,0,0"/></StackPanel></Border></Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Print Department Slip" Width="170" Height="40" Click="Print_Click"/></StackPanel></Grid></Window>