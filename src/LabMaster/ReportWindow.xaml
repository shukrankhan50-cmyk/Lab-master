<Window x:Class="LabMaster.ReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reports" Height="800" Width="1250" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Laboratory Reports" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Review, verify and print professional laboratory reports" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OrdersGrid_SelectionChanged" Background="{StaticResource CardBrush}" Foreground="White" RowBackground="{StaticResource CardBrush}" AlternatingRowBackground="#243044"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="95"/><DataGridTextColumn Header="Report" Binding="{Binding ReportNumber}" Width="120"/><DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="95"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Column="1" Background="White" Margin="15,0,0,0" Padding="35"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ReportPanel" Width="700">
<TextBlock x:Name="LabNameText" Text="LABORATORY" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111827"/>
<TextBlock x:Name="LabAddressText" Text="" FontSize="12" HorizontalAlignment="Center" Foreground="#4B5563" TextAlignment="Center"/>
<TextBlock x:Name="LabPhoneText" Text="" FontSize="12" HorizontalAlignment="Center" Foreground="#4B5563" Margin="0,2,0,18"/>
<Border BorderBrush="#D1D5DB" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PatientInfo" FontSize="13" Foreground="#111827"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="ReportInfo" FontSize="13" Foreground="#111827" TextAlignment="Right"/></StackPanel></Grid></Border>
<TextBlock Text="LABORATORY RESULTS" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
<DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Height="330" Background="White" Foreground="#111827" BorderBrush="#D1D5DB"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="2*"/><DataGridTextColumn Header="Result" Binding="{Binding ResultValue}" Width="1.2*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1*"/><DataGridTextColumn Header="Reference Range" Binding="{Binding ReferenceRange}" Width="1.5*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="CommentLabel" Text="Comments / Interpretation" FontWeight="Bold" Foreground="#111827" Margin="0,18,0,4"/>
<TextBlock x:Name="CommentText" Foreground="#374151" TextWrapping="Wrap"/>
<Border BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Margin="0,25,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Technician" FontWeight="Bold" Foreground="#111827"/><TextBlock Text="________________" Foreground="#6B7280"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Verified By" FontWeight="Bold" Foreground="#111827"/><TextBlock x:Name="VerifiedText" Foreground="#374151"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Report Status" FontWeight="Bold" Foreground="#111827"/><TextBlock x:Name="StatusText" Foreground="#374151"/></StackPanel></Grid></Border>
<TextBlock x:Name="FooterText" Foreground="#6B7280" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"/>
</StackPanel></ScrollViewer></Border></Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Verify Report" Width="130" Height="40" Margin="0,0,10,0" Click="Verify_Click"/><Button Content="Print Report" Width="120" Height="40" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="Print_Click"/></StackPanel></Grid></Window>