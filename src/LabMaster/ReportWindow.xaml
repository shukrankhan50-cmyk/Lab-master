<Window x:Class="LabMaster.ReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reports" Height="760" Width="1200" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Laboratory Reports" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Review entered results, verify and print reports" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OrdersGrid_SelectionChanged" Background="{StaticResource CardBrush}" Foreground="White" RowBackground="{StaticResource CardBrush}" AlternatingRowBackground="#243044"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="95"/><DataGridTextColumn Header="Report" Binding="{Binding ReportNumber}" Width="120"/><DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="95"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Column="1" Background="White" Margin="15,0,0,0" Padding="30"><ScrollViewer><StackPanel x:Name="ReportPanel"><TextBlock Text="LABORATORY REPORT" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PatientInfo" FontSize="14" Margin="0,20,0,15"/><DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/><DataGridTextColumn Header="Result" Binding="{Binding ResultValue}" Width="150"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100"/><DataGridTextColumn Header="Reference Range" Binding="{Binding ReferenceRange}" Width="180"/></DataGrid.Columns></DataGrid><TextBlock x:Name="CommentText" Margin="0,15,0,0" FontStyle="Italic"/><TextBlock x:Name="VerifiedText" Margin="0,30,0,0" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></Border>
</Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Verify Report" Width="130" Height="40" Margin="0,0,10,0" Click="Verify_Click"/><Button Content="Print" Width="110" Height="40" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="Print_Click"/></StackPanel>
</Grid></Window>