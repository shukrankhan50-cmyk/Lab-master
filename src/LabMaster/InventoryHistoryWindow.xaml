<Window x:Class="LabMaster.InventoryHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inventory Transaction History" Height="560" Width="950" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" Text="Inventory Transaction History" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Date/Time" Binding="{Binding CreatedAt,StringFormat=dd-MMM-yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="160"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/><DataGridTextColumn Header="User" Binding="{Binding CreatedBy}" Width="130"/></DataGrid.Columns></DataGrid></Grid></Window>