<Window x:Class="LabMaster.AddProfileTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Test to Profile" Height="360" Width="620" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="24"><StackPanel><TextBlock Text="Add Test to Profile" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Search test" Foreground="White"/><TextBox x:Name="SearchBox" Height="36" Margin="0,5,0,12" TextChanged="Search_TextChanged"/><ComboBox x:Name="TestBox" Height="38" DisplayMemberPath="TestName"/><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,14"/><Button Content="ADD TEST" Height="42" Click="Save_Click"/></StackPanel></Grid></Window>