<Window x:Class="LabMaster.ChangePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Set / Change Password" Height="360" Width="430" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><StackPanel Margin="30"><TextBlock Text="Set / Change Password" FontSize="26" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="UserLabel" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/><TextBlock Text="New password (minimum 8 characters)" Foreground="White" Margin="0,0,0,5"/><PasswordBox x:Name="PasswordBox" Height="36" Margin="0,0,0,10"/><TextBlock Text="Confirm password" Foreground="White" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmBox" Height="36" Margin="0,0,0,18"/><Button Content="SAVE PASSWORD" Height="42" Click="Save_Click"/><TextBlock x:Name="StatusText" Foreground="#FCA5A5" Margin="0,10,0,0"/></StackPanel></Window>