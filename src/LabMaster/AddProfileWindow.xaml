<Window x:Class="LabMaster.AddProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Profile" Height="300" Width="500" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="30"><StackPanel VerticalAlignment="Center"><TextBlock Text="Add Test Profile" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Profile Code" Foreground="White"/><TextBox x:Name="CodeBox" Height="38" Margin="0,5,0,14"/><TextBlock Text="Profile Name" Foreground="White"/><TextBox x:Name="NameBox" Height="38" Margin="0,5,0,20"/><Button Content="SAVE PROFILE" Height="42" Click="Save_Click"/></StackPanel></Grid></Window>