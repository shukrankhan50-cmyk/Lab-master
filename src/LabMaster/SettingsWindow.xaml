<Window x:Class="LabMaster.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="System Settings" Height="500" Width="760" Background="{StaticResource BackgroundBrush}"><Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="System Settings" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/><StackPanel Grid.Row="1"><TextBlock Text="Laboratory Name" Foreground="White"/><TextBox x:Name="NameBox" Height="38" Margin="0,5,0,15"/><TextBlock Text="Address" Foreground="White"/><TextBox x:Name="AddressBox" Height="38" Margin="0,5,0,15"/><TextBlock Text="Phone" Foreground="White"/><TextBox x:Name="PhoneBox" Height="38" Margin="0,5,0,15"/><TextBlock Text="Report Footer" Foreground="White"/><TextBox x:Name="FooterBox" Height="60" Margin="0,5,0,15"/></StackPanel><Button Grid.Row="2" Content="SAVE SETTINGS" Height="42" Click="Save_Click"/></Grid></Window>