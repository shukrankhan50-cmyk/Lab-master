<Window x:Class="LabMaster.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inventory &amp; Reagents" Height="720" Width="1150" Background="{StaticResource BackgroundBrush}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Inventory &amp; Reagents" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="AlertText" Foreground="#FCA5A5" Margin="0,5,0,15"/></StackPanel><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="120"/><DataGridTextColumn Header="Expiry" Binding="{Binding Expiry,StringFormat=dd-MMM-yyyy}" Width="120"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Minimum" Binding="{Binding Minimum}" Width="90"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="70"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><TextBox x:Name="QtyBox" Width="110" Height="38" Padding="8" Margin="0,0,8,0"/><ComboBox x:Name="TypeBox" Width="110" Height="38" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="IN"/><ComboBoxItem Content="OUT"/></ComboBox><TextBox x:Name="ReferenceBox" Width="150" Height="38" Padding="8" Margin="0,0,8,0"/><TextBox x:Name="NotesBox" Width="220" Height="38" Padding="8" Margin="0,0,8,0"/><Button Content="Post Stock" Width="130" Height="38" Click="Stock_Click"/><Button Content="Add Item" Width="120" Height="38" Margin="8,0,0,0" Click="Add_Click"/></StackPanel><TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/></Grid></Window>