<Window x:Class="LabMaster.PatientRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Registration" Height="720" Width="920" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,12,14"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Patient Registration" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Create a patient record. The MR number is assigned by the database."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="MR number" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MrBox" IsReadOnly="True" Margin="0,5,14,16"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="Patient name *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NameBox" Margin="0,5,0,16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Father / husband name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="FatherBox" Margin="0,5,14,16"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Gender" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="GenderBox" Height="38" Margin="0,5,0,16" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Male" IsSelected="True"/>
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Date of birth" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DobBox" Height="38" Margin="0,5,14,16" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Age (if date of birth is unknown)" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,16">
                            <TextBox x:Name="AgeYearsBox" Width="58" Margin="0,0,3,0" ToolTip="Years"/>
                            <TextBlock Text="Y" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="AgeMonthsBox" Width="58" Margin="0,0,3,0" ToolTip="Months"/>
                            <TextBlock Text="M" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="AgeDaysBox" Width="58" Margin="0,0,3,0" ToolTip="Days"/>
                            <TextBlock Text="D" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="PhoneBox" Margin="0,5,14,16"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="Referring doctor" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DoctorBox" Margin="0,5,0,16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="AddressBox" Height="66" Padding="10,8" VerticalContentAlignment="Top"
                                 AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,16"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Grid.Row="5" Grid.ColumnSpan="2"
                               Text="Enter the patient details, then select Save Patient."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Clear form" Width="110" Height="40" Margin="0,0,10,0" Click="Clear_Click"/>
            <Button x:Name="SaveButton" Content="Save patient" Width="150" Height="40"
                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>