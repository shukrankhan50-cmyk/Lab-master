<Window x:Class="LabMaster.QCHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QC Result History" Height="560" Width="900" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" Text="QC Result History" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Date/Time" Binding="{Binding RunDate,StringFormat=dd-MMM-yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Result" Binding="{Binding Value}" Width="100"/><DataGridTextColumn Header="Entered By" Binding="{Binding EnteredBy}" Width="150"/><DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Window>