<Window x:Class="LabMaster.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Master Activation" Height="470" Width="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="35">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="LAB MASTER ACTIVATION" Foreground="{StaticResource AccentBrush}"
                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="This PC requires a valid activation key to open Lab Master."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,8,0,24"/>
            <TextBlock Text="PC Activation ID" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="MachineIdBox" IsReadOnly="True" Height="38" Padding="10"
                     Margin="0,6,0,16"/>
            <TextBlock Text="Activation Key" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="KeyBox" Height="100" Padding="10" Margin="0,6,0,18"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <Button Content="ACTIVATE" Height="44" Click="Activate_Click"/>
            <TextBlock x:Name="StatusText" Foreground="#FCA5A5" HorizontalAlignment="Center"
                       Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>