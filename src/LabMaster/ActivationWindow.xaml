<Window x:Class="LabMaster.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Master Activation" Height="450" Width="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="36">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="LAB MASTER ACTIVATION" Foreground="{StaticResource AccentBrush}"
                       FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="One shared activation key works on any PC. Each key is valid for 90 days."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,9,0,26"/>
            <TextBlock Text="Shared activation key" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
            <TextBox x:Name="KeyBox" Height="100" Padding="12" Margin="0,7,0,18"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     ToolTip="Paste the complete shared activation key here"/>
            <Button Content="ACTIVATE" Height="44" Click="Activate_Click"/>
            <TextBlock x:Name="StatusText" Foreground="#FCA5A5" HorizontalAlignment="Center"
                       Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>