<Window x:Class="LabMaster.DepartmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Departments" Height="600" Width="700" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Department Master" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding DepartmentId}" Width="80"/><DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Window>