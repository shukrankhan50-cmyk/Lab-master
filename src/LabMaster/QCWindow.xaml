<Window x:Class="LabMaster.QCWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quality Control" Height="650" Width="1050" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Quality Control" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,15"/><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/><DataGridTextColumn Header="Lot" Binding="{Binding Lot}" Width="120"/><DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="180"/><DataGridTextColumn Header="Mean" Binding="{Binding Mean}" Width="100"/><DataGridTextColumn Header="SD" Binding="{Binding SD}" Width="100"/><DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><Button Content="Add QC Material" Width="150" Height="40" Click="Add_Click"/></StackPanel></Grid></Window>