<Window x:Class="LabMaster.QCWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quality Control" Height="700" Width="1100" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Quality Control" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,15"/><TextBlock x:Name="FlagText" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/></StackPanel><DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" Background="{StaticResource CardBrush}" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/><DataGridTextColumn Header="Lot" Binding="{Binding Lot}" Width="110"/><DataGridTextColumn Header="Test" Binding="{Binding Test}" Width="160"/><DataGridTextColumn Header="Mean" Binding="{Binding Mean}" Width="90"/><DataGridTextColumn Header="SD" Binding="{Binding SD}" Width="90"/><DataGridTextColumn Header="Expiry" Binding="{Binding Expiry,StringFormat=dd-MMM-yyyy}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><TextBox x:Name="ResultBox" Width="120" Height="38" Padding="8" Margin="0,0,8,0"/><TextBox x:Name="CommentBox" Width="260" Height="38" Padding="8" Margin="0,0,8,0"/><Button Content="Save QC Result" Width="145" Height="38" Click="SaveResult_Click"/><Button Content="Add QC Material" Width="150" Height="38" Margin="8,0,0,0" Click="Add_Click"/></StackPanel></Grid></Window>