<Window x:Class="LabMaster.AnalyzerMaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Analyzer Maintenance History" Height="620" Width="1050" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="22">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="TitleText" Text="Analyzer Maintenance History" Foreground="White" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="InfoText" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,15"/></StackPanel>
<DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}" Foreground="White">
<DataGrid.Columns>
<DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=dd-MMM-yyyy}" Width="105"/>
<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
<DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy}" Width="130"/>
<DataGridTextColumn Header="Next Due" Binding="{Binding NextDueDate,StringFormat=dd-MMM-yyyy}" Width="110"/>
<DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="100"/>
<DataGridTextColumn Header="Cost" Binding="{Binding Cost,StringFormat=N2}" Width="90"/>
<DataGridTextColumn Header="Certificate" Binding="{Binding CertificateNumber}" Width="130"/>
<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Add Maintenance / Calibration" Width="210" Height="38" Click="Add_Click"/><Button Content="Close" Width="100" Height="38" Margin="8,0,0,0" Click="Close_Click"/></StackPanel>
</Grid></Window>