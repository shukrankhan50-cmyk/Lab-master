<Window x:Class="LabMaster.ResultEntryWindow" PreviewKeyDown="Window_PreviewKeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Result Entry (F3)" Height="720" Width="1200" WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Result Entry (F3)" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Enter and save pending laboratory results" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/></StackPanel>
<DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" Background="{StaticResource CardBrush}" Foreground="White" RowBackground="{StaticResource CardBrush}" AlternatingRowBackground="#243044" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
<DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="110"/><DataGridTextColumn Header="MR" Binding="{Binding MRNumber}" Width="110"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="180"/><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="220"/><DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="150"/><DataGridTextColumn Header="Current Result" Binding="{Binding ResultValue}" Width="*"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="15" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SelectedTestLabel" Text="Select a pending test" Foreground="White" VerticalAlignment="Center" Width="300"/><TextBox x:Name="ResultBox" Width="300" Height="38" Margin="10,0"/><TextBox x:Name="CommentBox" Width="300" Height="38" Margin="10,0" ToolTip="Comment"/><Button Content="Save Result" Width="130" Height="38" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="Save_Click"/></StackPanel></Border>
</Grid></Window>